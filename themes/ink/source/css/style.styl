:root {
  --bg: #fbfaf7;
  --surface: #f4f2ec;
  --text: #211f1c;
  --text-2: #6d675f;
  --text-3: #9a938a;
  --line: #e7e3da;
  --line-strong: #d6d0c4;
  --accent: #a9492e;
  --maxw: 720px;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Source Han Sans SC", sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Courier New", monospace;
}

html[data-theme="dark"] {
  --bg: #161513;
  --surface: #1e1c19;
  --text: #e9e5dd;
  --text-2: #a39b90;
  --text-3: #736c63;
  --line: #2b2823;
  --line-strong: #3b3731;
  --accent: #e0855f;
}

@media (prefers-color-scheme: dark) {
  html:not([data-theme="light"]) {
    --bg: #161513;
    --surface: #1e1c19;
    --text: #e9e5dd;
    --text-2: #a39b90;
    --text-3: #736c63;
    --line: #2b2823;
    --line-strong: #3b3731;
    --accent: #e0855f;
  }
}

* { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.85;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background-color .25s ease, color .25s ease;
}

a { color: inherit; text-decoration: none; }

img { max-width: 100%; height: auto; }

::selection { background: var(--line-strong); }

.shell {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
}

.site-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  padding: 36px 0 18px;
  border-bottom: 1px solid var(--line);
}

.brand {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: .02em;
  transition: color .18s;
}

.brand:hover { color: var(--accent); }

.nav {
  display: flex;
  align-items: baseline;
  gap: 20px;
  font-size: 13.5px;
  color: var(--text-2);
}

.nav a { position: relative; transition: color .18s; }
.nav a:hover { color: var(--text); }
.nav a.on { color: var(--text); }

.nav a.on::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -6px;
  height: 1px;
  background: var(--accent);
}

.theme-btn {
  font: inherit;
  font-size: 13px;
  color: var(--text-3);
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  transition: color .18s;
}

.theme-btn:hover { color: var(--text); }

.main {
  min-height: 58vh;
  padding-bottom: 40px;
}

.hero {
  padding: 64px 0 52px;
  border-bottom: 1px solid var(--line);
}

.hero-title {
  font-size: 30px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: -.01em;
  margin: 0;
}

.hero-meta {
  margin: 16px 0 0;
  font-size: 13.5px;
  color: var(--text-3);
}

.sep { margin: 0 7px; color: var(--text-3); }

.entry {
  display: grid;
  grid-template-columns: 98px 1fr;
  gap: 22px;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
}

.entry:last-child { border-bottom: 0; }

.entry-date {
  font-size: 12.5px;
  color: var(--text-3);
  letter-spacing: .04em;
  font-variant-numeric: tabular-nums;
  padding-top: 5px;
}

.entry-title {
  font-size: 17.5px;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: -.005em;
  margin: 0;
}

.entry-title a { transition: color .18s; }
.entry-title a:hover { color: var(--accent); }

.entry-excerpt {
  margin: 8px 0 0;
  font-size: 14.5px;
  line-height: 1.75;
  color: var(--text-2);
}

.pager {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 34px;
  padding-top: 22px;
  border-top: 1px solid var(--line);
  font-size: 13.5px;
  color: var(--text-2);
}

.pager-link { transition: color .18s; }
.pager-link:hover { color: var(--accent); }

.pager-count {
  font-size: 12.5px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.page-head {
  padding: 56px 0 38px;
  border-bottom: 1px solid var(--line);
}

.page-title {
  font-size: 26px;
  font-weight: 500;
  letter-spacing: -.01em;
  margin: 0;
}

.page-meta {
  margin: 14px 0 0;
  font-size: 13.5px;
  color: var(--text-3);
}

.year-group { margin-top: 42px; }

.year-label {
  font-size: 12.5px;
  font-weight: 500;
  color: var(--text-3);
  letter-spacing: .1em;
  margin: 0 0 12px;
  font-variant-numeric: tabular-nums;
}

.year-item {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 18px;
  align-items: baseline;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
}

.year-item time {
  font-size: 12.5px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.year-item a { font-size: 15.5px; transition: color .18s; }
.year-item a:hover { color: var(--accent); }

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 38px;
}

.tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: var(--surface);
  border-radius: 999px;
  font-size: 14px;
  transition: background .18s;
}

.tag-pill:hover { background: var(--line); }

.tag-count { font-size: 12px; color: var(--text-3); }

.empty {
  margin-top: 38px;
  font-size: 14px;
  color: var(--text-3);
  line-height: 1.9;
}

.post { padding-top: 56px; }

.post-head {
  padding-bottom: 30px;
  border-bottom: 1px solid var(--line);
}

.post-title {
  font-size: 29px;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: -.015em;
  margin: 0;
}

.post-meta {
  margin: 16px 0 0;
  font-size: 13px;
  color: var(--text-3);
  line-height: 1.7;
}

.tag { transition: color .18s; }
.tag:hover { color: var(--accent); }

.post-content {
  padding: 34px 0 8px;
  font-size: 16px;
  line-height: 1.9;
  word-break: break-word;
}

.post-content > *:first-child { margin-top: 0; }
.post-content > *:last-child { margin-bottom: 0; }

.post-content p { margin: 0 0 1.45em; }

.post-content h2 {
  font-size: 20px;
  font-weight: 500;
  line-height: 1.55;
  letter-spacing: -.01em;
  margin: 2.1em 0 .75em;
}

.post-content h3 {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.6;
  margin: 1.8em 0 .65em;
}

.post-content h4 {
  font-size: 16px;
  font-weight: 500;
  margin: 1.6em 0 .6em;
}

.post-content a {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
  text-decoration-color: currentColor;
}

.post-content a:hover { text-decoration-thickness: 2px; }

.post-content blockquote {
  margin: 1.7em 0;
  padding: 2px 0 2px 20px;
  border-left: 2px solid var(--line-strong);
  color: var(--text-2);
}

.post-content blockquote p:last-child { margin-bottom: 0; }

.post-content ul,
.post-content ol {
  margin: 0 0 1.4em;
  padding-left: 1.35em;
}

.post-content li { margin: .3em 0; }
.post-content li::marker { color: var(--text-3); }

.post-content hr {
  border: 0;
  border-top: 1px solid var(--line);
  margin: 2.3em 0;
}

.post-content img {
  display: block;
  margin: 1.6em auto;
  border-radius: 8px;
}

.post-content code {
  font-family: var(--mono);
  font-size: .875em;
  background: var(--surface);
  padding: 2px 6px;
  border-radius: 4px;
}

.post-content pre {
  margin: 1.6em 0;
  padding: 16px 18px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow-x: auto;
  font-size: 13.5px;
  line-height: 1.7;
}

.post-content pre code {
  background: none;
  padding: 0;
  font-size: inherit;
}

.post-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.6em 0;
  font-size: 14.5px;
}

.post-content th,
.post-content td {
  padding: 9px 12px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}

.post-content th {
  font-weight: 500;
  color: var(--text-2);
  border-bottom-color: var(--line-strong);
}

.post-license {
  margin: 46px 0 0;
  font-size: 12.5px;
  line-height: 1.8;
  color: var(--text-3);
}

.post-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 38px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
}

.post-nav-item {
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 15px 18px;
  background: var(--surface);
  border-radius: 10px;
  transition: background .18s;
}

.post-nav-item:hover { background: var(--line); }
.post-nav-item.is-next { text-align: right; }
.post-nav-item.is-empty { background: none; }

.post-nav.is-single { grid-template-columns: 1fr; }
.post-nav.is-single .post-nav-item.is-next { text-align: left; }

.post-nav-dir { font-size: 12px; color: var(--text-3); }

.post-nav-title {
  font-size: 14.5px;
  font-weight: 500;
  line-height: 1.55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.site-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  padding: 40px 0 56px;
  border-top: 1px solid var(--line);
  font-size: 12.5px;
  color: var(--text-3);
}

.site-foot a { transition: color .18s; }
.site-foot a:hover { color: var(--text-2); }

@media (max-width: 640px) {
  .shell { padding: 0 20px; }
  .site-head { padding: 26px 0 15px; }
  .nav { gap: 16px; font-size: 13px; }
  .hero { padding: 42px 0 34px; }
  .hero-title { font-size: 23px; }
  .entry { grid-template-columns: 1fr; gap: 7px; padding: 22px 0; }
  .entry-date { padding-top: 0; }
  .entry-title { font-size: 16.5px; }
  .page-head { padding: 42px 0 30px; }
  .post { padding-top: 42px; }
  .post-title { font-size: 23px; }
  .post-content { font-size: 15.5px; line-height: 1.85; }
  .post-nav { grid-template-columns: 1fr; }
  .post-nav-item.is-next { text-align: left; }
  .year-item { grid-template-columns: 52px 1fr; gap: 14px; }
}
