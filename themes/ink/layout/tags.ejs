<%
  var tags = site.tags.toArray().sort(function (a, b) { return b.length - a.length; });
%>

<header class="page-head">
  <h1 class="page-title">标签</h1>
  <p class="page-meta">共 <%= tags.length %> 个标签</p>
</header>

<div class="tag-cloud">
  <% tags.forEach(function (tag) { %>
    <a class="tag-pill" href="<%- url_for(tag.path) %>">
      <%= tag.name %><span class="tag-count"><%= tag.length %></span>
    </a>
  <% }); %>
</div>

<% if (!tags.length) { %>
  <p class="empty">还没有标签。写文章时在开头加一行 <code>tags: [想法]</code> 就会出现在这里。</p>
<% } %>
